model profiles {
  id                String    @id(map: "users_pkey") @db.Uuid
  firstname_th      String?   @db.VarChar(255)
  lastname_th       String?   @db.VarChar(255)
  firstname_en      String?   @db.VarChar(255)
  lastname_en       String?   @db.VarChar(255)
  sex_id            Int?
  birth_date        DateTime? @db.Date
  nationality       Int?
  race              Int?
  mstatus           Int?
  occupation        Int?
  phone             String?   @db.VarChar(15)
  current_maininscl Int?
  subdistrict_code  Int?
  district_code     Int?
  province_code     Int?
  zip_code          Int?
  address_detail    String?   @db.VarChar(255)
  cid               String?   @db.VarChar(13)
  profession_id     String?   @db.VarChar(50)
  title_code        String?   @db.VarChar(3)
  system            String[]  @default([])
  department        String[]  @default([])
  role              String?   @db.VarChar(50)
  status_           String?   @map("status ") @db.VarChar
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)
  users             users     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model roles {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  role_name_en String
  role_name_th String
  description  String?
  is_disabled  Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)

  @@schema("public")
}

model supplier {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  contact    String?
  address    String?
  phone      String?
  tax_id     String?
  active     Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@schema("public")
}

model systems {
  id          Int       @id @default(autoincrement())
